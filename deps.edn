{:paths ["src" "resources" "examples"]
 :group-id "tech.unravel"
 :artifact-id "dscloj"
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; Pinned to the v0.4.170 tag: it carries the direct provider
        ;; support on top of the reflection and list-shape fixes. Bump
        ;; :git/sha to move forward.
        tech.unravel/litellm-clj
        {:git/url "https://github.com/unravel-team/litellm-clj.git"
         :git/sha "21f66332082c56c6270700bf3c0322a12ad22a5f"}
        metosin/malli {:mvn/version "0.16.4"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.scicloj/clay {:mvn/version "2.0.2"}
        org.clojure/core.async {:mvn/version "1.6.681"}}
 
 ;; POM metadata for deps-deploy (pom.xml auto-generated during deployment)
 :mvn/repos {"clojars" {:url "https://repo.clojars.org/"}}
 
 :pom-data {:description "A Clojure library inspired by DSPy, providing a declarative approach to building and optimizing language model pipelines"
            :url "https://github.com/unravel-team/DSCloj"
            :licenses [{:name "MIT License"
                        :url "https://opensource.org/licenses/MIT"}]
            :scm {:url "https://github.com/unravel-team/DSCloj"
                  :connection "scm:git:git://github.com/unravel-team/DSCloj.git"
                  :developerConnection "scm:git:ssh://git@github.com/unravel-team/DSCloj.git"
                  :tag "HEAD"}}
 
 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.0"}}}
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}}
  :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                      markdown-clj/markdown-clj {:mvn/version "1.12.4"}
                      cider/cider-nrepl {:mvn/version "0.50.2"}}}
  :nrepl {:extra-paths ["test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
	  ;; this allows nrepl to interrupt runaway repl evals
          :jvm-opts ["-Djdk.attach.allowAttachSelf"]
          :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.11"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}}
          :ns-default build}
  :kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.03.13"}}
          :main-opts ["-m" "clj-kondo.main"]}}}
